# Higgsfield Cloud API (required to generate video)
# Create keys at https://cloud.higgsfield.ai
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Optional combined form: id:secret
# HF_CREDENTIALS=

# Primary for single-photo hero clips. Transitions use DoP (start + end frame).
HF_VIDEO_MODEL=kling-video/v2.1/pro/image-to-video
# Transitions: DoP turbo (faster). Use dop/standard for higher quality.
HF_TRANSITION_MODEL=higgsfield-ai/dop/turbo
HF_VIDEO_FALLBACK_MODEL=higgsfield-ai/dop/turbo
HF_RESOLUTION=720p
HF_CLIP_DURATION=4
HF_GENERATION_CONCURRENCY=2
# HF_ENHANCE_PROMPT=true

# Vision tagging + transition planning (recommended for smoother morphs)
# Without a key, filename heuristics and generic prompts are used.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
